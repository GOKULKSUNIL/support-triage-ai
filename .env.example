# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore — never commit real keys.

# Primary model provider (Groq, OpenAI-compatible API)
LLM_API_KEY=your_groq_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Fallback provider (OpenRouter), used if the primary is down or rate-limited.
# Leave the key blank to disable the fallback.
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct

EMBEDDING_MODEL=all-MiniLM-L6-v2

CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db

LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.80
RETRIEVAL_TOP_K=5
