# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore — never commit real keys.

# Primary model provider (Groq, OpenAI-compatible API)
LLM_API_KEY=your_groq_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Fallback model, used when the main one is down or its allowance is used up.
# With the key and base URL blank, FALLBACK_MODEL runs on the main provider
# (Groq counts limits per model). To use another provider, set all three.
# Leave FALLBACK_MODEL blank too to disable the fallback.
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL=openai/gpt-oss-120b

EMBEDDING_MODEL=all-MiniLM-L6-v2

CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db

LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.80
RETRIEVAL_TOP_K=5
RELEVANCE_THRESHOLD=0.40

# Model calls: seconds before a call times out; folder for cached responses
LLM_TIMEOUT=20
LLM_CACHE_DIR=./cache/llm

# Trained classifier (rebuilt from data/development_tickets.json if missing)
CLASSIFIER_PATH=./storage/classifier.joblib
